{
  "name": "ancoda-atlas",
  "version": "4.0.0",
  "description": "Nepal emergency disaster intelligence \u2014 5 natural-hazard sources, live dashboard, auto-refresh, optional LLM layer.",
  "author": "Ancoda Labs",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/ancoda-labs/Ancoda-Atlas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ancoda-labs/Ancoda-Atlas.git"
  },
  "bugs": {
    "url": "https://github.com/ancoda-labs/Ancoda-Atlas/issues",
    "email": "research@ancodalabs.com"
  },
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "start": "next start",
    "dev": "next dev",
    "build": "next build",
    "check:no-any": "node scripts/check-no-any.mjs",
    "test": "node --experimental-strip-types --import ./scripts/register-test-alias.mjs --test test/*.test.mjs",
    "verify": "npm run check:no-any && npm test && npm run build"
  },
  "keywords": [
    "disaster",
    "emergency",
    "natural-hazard",
    "earthquake",
    "flood",
    "landslide",
    "wildfire",
    "monsoon",
    "seismic",
    "nepal",
    "himalaya",
    "dashboard"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
