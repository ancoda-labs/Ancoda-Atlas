#!/bin/sh
set -eu

commit_subject=$(head -n 1 "$1")
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^[:space:]]+\))?!?: [^[:space:]].{0,71}$'

if ! printf '%s\n' "$commit_subject" | grep -Eq "$pattern"; then
  echo "Invalid commit subject."
  echo "Use: type(scope): subject"
  echo "Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  exit 1
fi
