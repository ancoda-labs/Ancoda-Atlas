FROM python:3.12-slim

# Atlas reads feeds and parses their bytes; it does not do OCR or image
# decoding through native libraries, so this stays deliberately thin. curl is
# for the healthcheck, and the build toolchain is only present because a couple
# of wheels still compile on arm64.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
# The dev extras too — this image is where pytest, ruff and mypy actually run,
# including from the pre-commit hook. There is no Python environment on the
# host to fall back to.
RUN pip install --no-cache-dir -e ".[dev]"

COPY . .
RUN chmod +x docker/*.sh

EXPOSE 8000

# /health answers as soon as the server is up, whether or not a sweep has
# completed, so it is the liveness probe. /health/ready reports the degraded
# state of Supabase and MinIO separately.
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -fsS http://localhost:8000/health > /dev/null || exit 1

CMD ["/app/docker/entrypoint.sh"]
