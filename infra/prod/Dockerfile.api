FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
# No dev extras: production runs the API and the worker, not the test suite.
RUN pip install --no-cache-dir .

COPY . .
RUN chmod +x docker/*.sh

# The sweeps write here. Declared so the image still starts if the host forgets
# to mount a volume — it degrades to a container-local directory rather than
# failing on a read-only filesystem.
RUN mkdir -p /app/runs

EXPOSE 8000

HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -fsS http://localhost:8000/health > /dev/null || exit 1

CMD ["/app/docker/entrypoint.sh"]
