# The Next.js frontend, built and served by its own Node process.
#
# Not a static export behind nginx: the dashboard's first paint is
# server-rendered from the API so that a reader on a slow connection gets the
# hazard figures in the HTML rather than after a round trip, and the flood desk
# pages carry per-page metadata. Both need a running Next server.

FROM node:22-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts

# The same install without the build-only half. `next start` never loads
# typescript, tailwind, postcss or the @types packages — they exist to turn
# source into .next, which has already happened by the time this image runs.
# Shipping the build tree instead cost ~200 MB in the runtime layer, and the
# deploy host has to unpack every one of them.
FROM node:22-alpine AS prod-deps
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Baked into the client bundle at build time, so it must be the address a
# browser can reach — not the internal service name.
# Baked into the browser bundle by `next build` below, so it must be an
# address a reader's browser can reach — and it is frozen once this layer is
# built. Changing it means rebuilding, not restarting.
#
# The `:-` fallback is load-bearing, not decoration. Coolify passes every
# variable through as `--build-arg NAME` with no value, which sets the ARG to
# the empty string when the UI field is blank and overrides whatever the
# compose file computed. An empty value here is not a harmless default: axios
# falls back to a same-origin `/api/v1`, every client-side call lands on the
# Next.js server instead of the API, and the site renders server-side while
# silently failing to refresh.
ARG NEXT_PUBLIC_API_BASE_URL=""
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL:-https://atlas-api.ancodalabs.com}
ARG ATLAS_API_BASE_URL=""
ENV ATLAS_API_BASE_URL=${ATLAS_API_BASE_URL:-http://api:8000}
RUN npm run build

FROM node:22-alpine AS run
WORKDIR /app
ENV NODE_ENV=production
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/next.config.mjs ./next.config.mjs

EXPOSE 3117
HEALTHCHECK --interval=60s --timeout=10s --start-period=40s --retries=3 \
  CMD wget -qO- http://localhost:${PORT:-3117}/ > /dev/null || exit 1

CMD ["sh", "-c", "npx next start -p ${PORT:-3117}"]
