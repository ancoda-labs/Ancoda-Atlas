# ─── Secrets ──────────────────────────────────────────────────────────────────
# Every .env at any depth — the root one both services read, and any that
# appear under backend/ or frontend/. .env.example is the tracked template and
# is exempted below.
#
# Next.js also reads .env.local, .env.development.local and .env.production.local
# without being told to, so those have to be covered by the pattern rather than
# listed one by one.
.env
.env.*
!.env.example
*.pem
*.key

# ─── Runtime data ─────────────────────────────────────────────────────────────
# The sweep snapshot, the flood desk store and the delta memory. The worker
# writes these; they are machine state, not source.
runs/
output/

# ─── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.npm/
.yarn/
.pnpm-store/

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
env/
build/
dist/
.eggs/
*.egg-info/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Celery, when a worker or beat is run on the host rather than in its container
celerybeat-schedule*
celerybeat.pid

# ─── Supabase CLI ─────────────────────────────────────────────────────────────
# Local CLI scratch. supabase/migrations/ is tracked — it is the schema.
supabase/.temp/
supabase/.branches/

# ─── Logs and process files ───────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
*.pid
*.seed

# ─── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Local agent and maintainer files ─────────────────────────────────────────
# next dev rewrites CLAUDE.md; AGENTS.md is tracked and must stay that way, or
# the working tree gains an uncommitted change on every dev server start.
.claude/
CLAUDE.md
MAINTAINER_DECISIONS.local.md

# ─── Misc ─────────────────────────────────────────────────────────────────────
.playwright-cli/
*.bak
