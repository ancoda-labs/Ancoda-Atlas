{
  "name": "atlas",
  "version": "4.0.0",
  "description": "Nepal emergency disaster intelligence — 5 natural-hazard sources, live dashboard, auto-refresh, optional LLM layer.",
  "author": "Ancoda Labs",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/ancodalabs/atlas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ancodalabs/atlas.git"
  },
  "bugs": {
    "url": "https://github.com/ancodalabs/atlas/issues",
    "email": "research@ancodalabs.com"
  },
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "start": "next start",
    "dev": "next dev",
    "build": "next build",
    "check:no-any": "node scripts/check-no-any.mjs",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "verify": "npm run check:no-any && npm test && npm run build",
    "sweep": "node apis/briefing.mjs",
    "synthesize": "node scripts/synthesize.mjs",
    "brief": "node apis/briefing.mjs",
    "brief:save": "node apis/save-briefing.mjs",
    "diag": "node scripts/diag.mjs",
    "clean": "node scripts/clean.mjs",
    "fresh-start": "npm run clean && npm run build && npm start",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "keywords": [
    "disaster",
    "emergency",
    "natural-hazard",
    "earthquake",
    "flood",
    "landslide",
    "wildfire",
    "monsoon",
    "seismic",
    "nepal",
    "himalaya",
    "dashboard"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "geist": "^1.7.2",
    "minio": "^8.0.7",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "optionalDependencies": {
    "discord.js": "^14.25.1"
  },
  "overrides": {
    "undici": "^7.24.4",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
