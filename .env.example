# ============================================
# Ancoda Atlas — Nepal Disaster Intelligence — Configuration
# ============================================
# Copy this file to .env and fill in your keys.
# Keys are optional — sources without keys degrade gracefully.
#
# IMPORTANT: Do NOT put comments on the same line as values.
# Docker env_file treats inline comments as part of the value.

# === Hazard Source API Keys ===
# Most sources need no key at all. USGS seismic and the Open-Meteo weather and
# air quality feeds are open. Only FIRMS and ReliefWeb ask for one.

# NASA FIRMS satellite fire detection over Nepal's provinces
# (free: firms.modaps.eosdis.nasa.gov/api)
FIRMS_MAP_KEY=
# ReliefWeb requires an approved appname since Nov 2025
# (apidoc.reliefweb.int/parameters#appname). Without it Atlas falls back to HDX.
RELIEFWEB_APPNAME=

# === Server Configuration ===

# Dashboard server port
PORT=3117
# Auto-refresh interval (minutes)
REFRESH_INTERVAL_MINUTES=15

# === Flood desk refresh ===
# Every live source behind /bhotekoshi-flood — BIPAD river gauges and incidents,
# the NDRRMA rescue register, the community missing/found register, YouTube
# coverage and the news wire — is pulled on this schedule rather than on a
# reader's request. Minimum 2 minutes; anything faster hammers government
# portals during the exact event that already has everyone else hammering them.
FLOOD_REFRESH_INTERVAL_MINUTES=10
# Optional. Set this to allow an external scheduler (systemd timer, Kubernetes
# CronJob, GitHub Actions) to trigger a cycle:
#   curl -X POST -H "Authorization: Bearer $FLOOD_REFRESH_TOKEN" \
#        https://your-host/api/flood/refresh
# While it is empty that endpoint answers 404 and only the in-process timer runs.
# GET /api/flood/refresh reports per-source health either way, without a token.
FLOOD_REFRESH_TOKEN=

# REQUIRED in production, and must be IDENTICAL on every instance.
#
# Signs the media-proxy URLs (/api/flood/media/image) that every photograph on
# the flood desk is served through — news images, the rescue portal's carousel,
# NDRRMA pictures, person-report photos, donation QR codes. The route will only
# fetch a URL Atlas signed itself, which is what stops it being an open proxy.
#
# Left unset, a random key is generated per process. Two consequences, and the
# second is the one that bites: a restart invalidates every link already on a
# reader's page until the next refresh, and behind more than one replica the
# signatures one container mints are rejected by the next — so images fail for
# roughly half of all requests, permanently.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATLAS_MEDIA_SECRET=

# Optional. Enables cross-channel YouTube search for flood coverage. Without it
# Atlas still reads the Nepali news channels it knows by id.
YOUTUBE_API_KEY=

# === Database — Supabase (optional) ===
# Backs the features that must remember something between requests: community
# ground-report photos, rescue corrections, and the ten-minute news digests.
# Leave these empty and each of them hides itself — the rest of Atlas (sweeps,
# gauges, reviewed relief content) needs no database at all.
#
# Atlas talks to Supabase over PostgREST rather than a Postgres socket, which is
# why this deploys to Netlify: a short-lived function makes one HTTP request and
# exits, with no connection pool to warm.
#
# Project URL — Settings > API. Safe to expose; the browser build reads it too.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key. Browser-facing, and deliberately powerless over the tables
# below: they have row-level security on with no policies attached.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key — Settings > API keys. Server-side only; it bypasses
# row-level security, so it must never gain a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
#
# The schema is not applied by the app — PostgREST cannot run DDL. Apply
# supabase/migrations/0001_flood_desk.sql once per project:
#   supabase db push        (or paste it into the SQL editor)
# then check it landed with: npm run db:migrate

# === Object storage — MinIO (optional) ===
# Where ground-report photo bytes live. Required together with the Supabase
# settings above for photo uploads to work.
#
# This bucket stores photographs uploaded by the public and nothing else.
# News images and video thumbnails are streamed from their source at request
# time and are never copied here.
#
# Host names belong in .env, not here — this file is committed.
# MINIO_PUBLIC_ENDPOINT is the host used to sign browser-facing URLs; leave it
# unset to reuse MINIO_ENDPOINT.
MINIO_ENDPOINT=
MINIO_PUBLIC_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_SECURE=true
MINIO_BUCKET=atlas
MINIO_REGION=us-east-1
# How long a signed photo URL stays valid.
MINIO_PRESIGNED_EXPIRY_SECONDS=3600

# === Community ground reports ===
# Salt for the hashed sender fingerprint used to rate-limit uploads. Without
# one, a random value is generated per process — rate limiting then works only
# until the next restart. Set it to any long random string in production.
ATLAS_IP_SALT=
# Bearer token for DELETE /api/flood/photos/{id}. While it is empty that route
# answers 404 and there is no way to take a photo down without a database
# client, so set it before opening uploads to the public.
FLOOD_ADMIN_TOKEN=

# === LLM Layer (optional) ===
# Enables AI-enhanced hazard reads and breaking-event alerts.
# Without it, Atlas falls back to the rule-based hazard engine.
# Provider options: anthropic | openai | gemini | codex | openrouter | minimax | mistral | ollama | grok | groq | tarka
LLM_PROVIDER=
# Not needed for codex (uses ~/.codex/auth.json) or ollama (local)
LLM_API_KEY=
# Optional override. Each provider has a sensible default:
# anthropic: claude-sonnet-4-6 | openai: gpt-5.4 | gemini: gemini-3.1-pro | codex: gpt-5.3-codex | openrouter: openrouter/auto | minimax: MiniMax-M2.5 | ollama: llama3.1:8b | grok: grok-4-latest | tarka: himalaya-gemma-4-bf16 (recommended; set explicitly)
LLM_MODEL=
# Tarka API base URL (only needed to override https://tarka.rest/v1)
LLM_BASE_URL=
# Ollama base URL (only needed if not using default http://localhost:11434)
OLLAMA_BASE_URL=

# === Telegram Alerts (optional) ===
# Create a bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated extra channel IDs to broadcast alerts to
TELEGRAM_CHANNELS=

# === Discord Alerts (optional) ===
# Bot mode gives slash commands; webhook mode is alerts only.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=
