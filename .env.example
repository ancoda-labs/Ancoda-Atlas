# ============================================
# Ancoda Atlas — Nepal Disaster Intelligence — Configuration
# ============================================
# Copy this file to .env and fill in your keys.
# Keys are optional — sources without keys degrade gracefully.
#
# IMPORTANT: Do NOT put comments on the same line as values.
# Docker env_file treats inline comments as part of the value.

# === Hazard Source API Keys ===
# Most sources need no key at all. USGS seismic and the Open-Meteo weather and
# air quality feeds are open. Only FIRMS and ReliefWeb ask for one.

# NASA FIRMS satellite fire detection over Nepal's provinces
# (free: firms.modaps.eosdis.nasa.gov/api)
FIRMS_MAP_KEY=
# ReliefWeb requires an approved appname since Nov 2025
# (apidoc.reliefweb.int/parameters#appname). Without it Atlas falls back to HDX.
RELIEFWEB_APPNAME=

# === Server Configuration ===

# Dashboard server port
PORT=3117
# Auto-refresh interval (minutes)
REFRESH_INTERVAL_MINUTES=15

# === Flood desk refresh ===
# Every live source behind /bhotekoshi-flood — BIPAD river gauges and incidents,
# the NDRRMA rescue register, the community missing/found register, YouTube
# coverage and the news wire — is pulled on this schedule rather than on a
# reader's request. Minimum 2 minutes; anything faster hammers government
# portals during the exact event that already has everyone else hammering them.
FLOOD_REFRESH_INTERVAL_MINUTES=10
# Optional. Set this to allow an external scheduler (systemd timer, Kubernetes
# CronJob, GitHub Actions) to trigger a cycle:
#   curl -X POST -H "Authorization: Bearer $FLOOD_REFRESH_TOKEN" \
#        https://your-host/api/flood/refresh
# While it is empty that endpoint answers 404 and only the in-process timer runs.
# GET /api/flood/refresh reports per-source health either way, without a token.
FLOOD_REFRESH_TOKEN=

# Optional. Stable key for signing news-image proxy URLs. Without one a random
# key is generated per process, so signed image links stop working after a
# restart until the next refresh cycle regenerates them.
ATLAS_MEDIA_SECRET=

# Optional. Enables cross-channel YouTube search for flood coverage. Without it
# Atlas still reads the Nepali news channels it knows by id.
YOUTUBE_API_KEY=

# === Database — Turso / libSQL (optional) ===
# Backs the features that must remember something between requests: community
# ground-report photos, rescue corrections, and the ten-minute news digests.
# Leave the URL empty and each of them hides itself — the rest of Atlas
# (sweeps, gauges, reviewed relief content) needs no database at all.
#
# Turso speaks HTTP rather than holding a socket, which is why this deploys to
# Netlify: a short-lived function makes one request and exits, with no pool to
# warm. Create one with:  turso db create atlas && turso db show atlas --url
TURSO_DATABASE_URL=
# turso db tokens create atlas
TURSO_AUTH_TOKEN=
#
# For local development you can skip Turso entirely and point at a file:
#   TURSO_DATABASE_URL=file:./atlas.db
# then run: npm run db:migrate

# === Object storage — MinIO (optional) ===
# Where ground-report photo bytes live. Same setup as the other Ancoda
# services. Required together with TURSO_DATABASE_URL for photo uploads to work.
#
# This bucket stores photographs uploaded by the public and nothing else.
# News images and video thumbnails are streamed from their source at request
# time and are never copied here.
MINIO_ENDPOINT=
MINIO_PUBLIC_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_SECURE=true
MINIO_BUCKET=atlas
MINIO_REGION=us-east-1
# How long a signed photo URL stays valid.
MINIO_PRESIGNED_EXPIRY_SECONDS=3600

# === Community ground reports ===
# Salt for the hashed sender fingerprint used to rate-limit uploads. Without
# one, a random value is generated per process — rate limiting then works only
# until the next restart. Set it to any long random string in production.
ATLAS_IP_SALT=
# Bearer token for DELETE /api/flood/photos/{id}. While it is empty that route
# answers 404 and there is no way to take a photo down without a database
# client, so set it before opening uploads to the public.
FLOOD_ADMIN_TOKEN=

# === LLM Layer (optional) ===
# Enables AI-enhanced hazard reads and breaking-event alerts.
# Without it, Atlas falls back to the rule-based hazard engine.
# Provider options: anthropic | openai | gemini | codex | openrouter | minimax | mistral | ollama | grok
LLM_PROVIDER=
# Not needed for codex (uses ~/.codex/auth.json) or ollama (local)
LLM_API_KEY=
# Optional override. Each provider has a sensible default:
# anthropic: claude-sonnet-4-6 | openai: gpt-5.4 | gemini: gemini-3.1-pro | codex: gpt-5.3-codex | openrouter: openrouter/auto | minimax: MiniMax-M2.5 | ollama: llama3.1:8b | grok: grok-4-latest
LLM_MODEL=
# Ollama base URL (only needed if not using default http://localhost:11434)
OLLAMA_BASE_URL=

# === Telegram Alerts (optional) ===
# Create a bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated extra channel IDs to broadcast alerts to
TELEGRAM_CHANNELS=

# === Discord Alerts (optional) ===
# Bot mode gives slash commands; webhook mode is alerts only.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=
