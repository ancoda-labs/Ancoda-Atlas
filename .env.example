# Ancoda Atlas — copy to .env. Every key is optional; unset features hide.
# Do NOT put comments on the same line as values — env_file keeps them.

# === Hazard sources ===
# firms.modaps.eosdis.nasa.gov/api — free, instant
FIRMS_MAP_KEY=
# apidoc.reliefweb.int/parameters#appname — free, approval required
RELIEFWEB_APPNAME=

# === Server ===
PORT=3117
API_HOST_PORT=8000
REDIS_HOST_PORT=6379
APP_ENV=development
LOG_LEVEL=INFO

# === API URLs ===
# Build-time, baked into the browser bundle. Empty = same-origin proxy in dev.
NEXT_PUBLIC_API_BASE_URL=
# Runtime, for the server renderer. Public URL on a split deploy.
ATLAS_API_BASE_URL=http://localhost:8000
# Comma separated. Must match the frontend origin on a split deploy.
ALLOWED_ORIGINS=http://localhost:3117

# === Schedules ===
ATLAS_RUNS_DIR=./runs
REFRESH_INTERVAL_MINUTES=15
# Minimum 2.
FLOOD_REFRESH_INTERVAL_MINUTES=10
# Bearer token for POST /api/v1/flood/refresh. Empty = route answers 404.
FLOOD_REFRESH_TOKEN=

# === Media proxy ===
# Required in production, identical on every instance: openssl rand -hex 32
ATLAS_MEDIA_SECRET=

# === Supabase (optional) ===
# Settings > API. Backs photos, rescue corrections and news digests.
NEXT_PUBLIC_SUPABASE_URL=
# Service-role key. Server-side only — never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# === MinIO (optional) ===
# Ground-report photo bytes. Needs Supabase too. Local sidecar: make storage
MINIO_ENDPOINT=
# Signs browser-facing URLs; unset reuses MINIO_ENDPOINT.
MINIO_PUBLIC_ENDPOINT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_SECURE=true
MINIO_BUCKET=atlas
MINIO_REGION=us-east-1
MINIO_PRESIGNED_EXPIRY_SECONDS=3600

# === Ground reports ===
# Salts hashed uploader IPs. Unset = limits reset on restart.
ATLAS_IP_SALT=
# Bearer token for DELETE /api/v1/flood/photos/{id}. Empty = route answers 404.
FLOOD_ADMIN_TOKEN=

# === LLM (optional) ===
# anthropic | openai | gemini | codex | openrouter | minimax | mistral | ollama | grok | groq | tarka
LLM_PROVIDER=
# Not needed for codex (~/.codex/auth.json) or ollama.
LLM_API_KEY=
# Required for tarka — it has no default. himalaya-gemma-4-q8 is the one
# Tarka chat id that actually translates; see the README provider table.
LLM_MODEL=
# Only to override a provider's published base. Tarka defaults to
# https://tarka.rest/v1 and needs nothing here.
LLM_BASE_URL=
OLLAMA_BASE_URL=
# low | medium | high. Unset lets the provider choose.
LLM_REASONING_EFFORT=

# === Ask sandbox ===
# Per hashed IP, and per process.
ASK_SANDBOX_MAX_TURNS_PER_HOUR=12
ASK_SANDBOX_MAX_GLOBAL_TURNS_PER_HOUR=80
ASK_SANDBOX_MAX_OUTPUT_TOKENS=500

# === Alerts (optional) ===
# One-way only; the interactive bots are not implemented.
# @BotFather for the token, @userinfobot for the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Channel Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# === Deployment — infra/prod, infra/split ===
DOMAIN_FRONTEND=atlas.ancodalabs.com
DOMAIN_API=atlas-api.ancodalabs.com
ACME_EMAIL=research@ancodalabs.com
# Absolute path outside the repo. Relative resolves against the compose file.
ATLAS_RUNS_PATH=./runs
