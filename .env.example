# ============================================
# Ancoda Atlas — Nepal Disaster Intelligence — Configuration
# ============================================
# Copy this file to .env and fill in your keys.
# Keys are optional — sources without keys degrade gracefully.
#
# IMPORTANT: Do NOT put comments on the same line as values.
# Docker env_file treats inline comments as part of the value.

# === Hazard Source API Keys ===
# Most sources need no key at all. USGS seismic and the Open-Meteo weather and
# air quality feeds are open. Only FIRMS and ReliefWeb ask for one.

# NASA FIRMS satellite fire detection over Nepal's provinces
# (free: firms.modaps.eosdis.nasa.gov/api)
FIRMS_MAP_KEY=
# ReliefWeb requires an approved appname since Nov 2025
# (apidoc.reliefweb.int/parameters#appname). Without it Atlas falls back to HDX.
RELIEFWEB_APPNAME=

# === Server Configuration ===

# Dashboard server port
PORT=3117
# Auto-refresh interval (minutes)
REFRESH_INTERVAL_MINUTES=15

# === LLM Layer (optional) ===
# Enables AI-enhanced hazard reads and breaking-event alerts.
# Without it, Atlas falls back to the rule-based hazard engine.
# Provider options: anthropic | openai | gemini | codex | openrouter | minimax | mistral | ollama | grok
LLM_PROVIDER=
# Not needed for codex (uses ~/.codex/auth.json) or ollama (local)
LLM_API_KEY=
# Optional override. Each provider has a sensible default:
# anthropic: claude-sonnet-4-6 | openai: gpt-5.4 | gemini: gemini-3.1-pro | codex: gpt-5.3-codex | openrouter: openrouter/auto | minimax: MiniMax-M2.5 | ollama: llama3.1:8b | grok: grok-4-latest
LLM_MODEL=
# Ollama base URL (only needed if not using default http://localhost:11434)
OLLAMA_BASE_URL=

# === Telegram Alerts (optional) ===
# Create a bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated extra channel IDs to broadcast alerts to
TELEGRAM_CHANNELS=

# === Discord Alerts (optional) ===
# Bot mode gives slash commands; webhook mode is alerts only.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=
